# Optional defaults only. The UI stores keys in localStorage instead.
VITE_OPENAI_API_KEY=
VITE_SPOTIFY_CLIENT_ID=

# Spotify Redirect URI (Spotify Dashboard Redirect URIs에 동일하게 등록)
# 로컬: http://127.0.0.1:5173/callback  (localhost는 Spotify에서 불가)
# 배포: https://media-recs-voice-poc-v2.vercel.app/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
